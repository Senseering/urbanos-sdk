{
  "name": "@datamatters-gmbh/urbanos-nuxt",
  "version": "0.2.0",
  "description": "Nuxt module wrapping the Vue bindings (plugin wiring, SSR safety, auto-imports).",
  "keywords": [
    "urbanos",
    "smart-city",
    "sdk",
    "nuxt",
    "module"
  ],
  "license": "Apache-2.0",
  "author": "dataMatters GmbH",
  "homepage": "https://github.com/Senseering/urbanos-sdk/tree/main/packages/nuxt#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Senseering/urbanos-sdk.git",
    "directory": "packages/nuxt"
  },
  "bugs": {
    "url": "https://github.com/Senseering/urbanos-sdk/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@datamatters-gmbh/urbanos-vue": "workspace:*"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
