{
  "name": "@datamatters-gmbh/urbanos-bridge",
  "version": "0.5.0",
  "description": "Embed protocol v2 (host + app sides). Zero dependencies, no framework.",
  "keywords": [
    "urbanos",
    "smart-city",
    "sdk",
    "iframe",
    "postmessage",
    "embed"
  ],
  "license": "Apache-2.0",
  "author": "dataMatters GmbH",
  "homepage": "https://github.com/Senseering/urbanos-sdk/tree/main/packages/bridge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Senseering/urbanos-sdk.git",
    "directory": "packages/bridge"
  },
  "bugs": {
    "url": "https://github.com/Senseering/urbanos-sdk/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
