{
  "name": "@senseering/urbanos-vue",
  "version": "0.1.0",
  "description": "Vue 3 composables and Uos* state components over the core client + bridge.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Senseering/urbanos-sdk.git",
    "directory": "packages/vue"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "main": "./dist/index.js",
