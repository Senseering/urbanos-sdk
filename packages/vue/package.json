{
  "name": "@datamatters-gmbh/urbanos-vue",
  "version": "0.2.3",
  "description": "Vue 3 plugin and composables over the urbanOS core client: createUrbanOS, useUrbanOS, useAppState.",
  "keywords": [
    "urbanos",
    "smart-city",
    "sdk",
    "vue",
    "composables"
  ],
  "license": "Apache-2.0",
  "author": "dataMatters GmbH",
  "homepage": "https://github.com/Senseering/urbanos-sdk/tree/main/packages/vue#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Senseering/urbanos-sdk.git",
    "directory": "packages/vue"
  },
  "bugs": {
    "url": "https://github.com/Senseering/urbanos-sdk/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@datamatters-gmbh/urbanos-core": "workspace:*",
    "@datamatters-gmbh/urbanos-bridge": "workspace:*",
    "@datamatters-gmbh/urbanos-demo": "workspace:*"
  },
  "peerDependencies": {
    "vue": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:"
  }
}
